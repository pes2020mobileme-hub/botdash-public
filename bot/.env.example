DISCORD_TOKEN=your_bot_token_here
API_PORT=3001
PREFIX=!
STATUS=online
ACTIVITY=Watching the dashboard
OWNERS=

# Origin ที่อนุญาตให้ dashboard เรียก API (คั่นด้วย comma) — เว้นว่าง = ทุก origin
CORS_ORIGIN=

# Deploy slash commands ตอนบอท ready — false = ปิด
DEPLOY_COMMANDS=true

# ถ้าตั้ง = deploy คำสั่งไปที่ guild เดียว (ขึ้นทันที) แทนทั้งโลก (ใช้ได้ ~1 ชม.)
GUILD_ID=

# Token สำหรับเข้า dashboard — สร้างด้วย: npm run token
# เว้นว่าง = ไม่ล็อก API (อันตราย อย่าทำบน production)
DASHBOARD_TOKEN=
