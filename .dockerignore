# Everything the image needs: bot/ and the dashboard SOURCE (the Dockerfile
# builds it in stage 1). Excluding dashboard/ here would break `COPY
# dashboard/ ./` and the build would fail with "not found".
.git
.gitignore
node_modules
**/node_modules
**/dist
**/build
.vercel

# runtime state — written by the bot, rebuilt on every deploy
bot/data

.env
.env.local
.env.*.local
*.log

# host configs and docs are not needed inside the image
README.md
render.yaml
railway.json
fly.toml
.dockerignore
